# Copy to .env and fill in. Every outside service is configured here, never in code.

# --- Database (Postgres 17) ---
# Local: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://kstirana:kstirana_dev@localhost:5433/kstirana

# --- Public site URL (used by auth callbacks and absolute links) ---
APP_URL=http://localhost:3000

# --- Admin login (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Photo storage ---
# Folder where processed photos are written (photos/<id>/sm|md|lg.webp).
STORAGE_DIR=./storage
# Public URL prefix for those files. Locally served by the /media route;
# on a VPS, Caddy/nginx serves STORAGE_DIR directly at this path.
MEDIA_BASE_URL=/media

# --- Email (SMTP) — Phase 6 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KS Tirana <no-reply@example.com>"
# Where Academy applications and contact messages are sent.
CLUB_INBOX=

# --- Local preview ---
# Show people who have no consent yet (and their photos) while developing.
# Only works with `npm run dev`; production builds always hide them.
CONTENT_PREVIEW=false
