{
  "name": "kf_tirana_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-migrate.ts status",
    "db:psql": "docker compose -f docker-compose.dev.yml exec db psql -U kstirana -d kstirana",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:reset": "tsx scripts/db-reset.ts && tsx scripts/db-migrate.ts",
    "import:photos": "tsx scripts/import-photos.ts",
    "import:workbook": "tsx scripts/import-workbook.ts",
    "blob:upload": "tsx scripts/upload-photos-blob.ts",
    "db:pull": "tsx scripts/pull-db.ts && tsx scripts/db-migrate.ts",
    "photos:pull": "tsx scripts/pull-photos.ts",
    "dev:setup": "npm run db:up && npm run db:pull && npm run photos:pull",
    "import:rosters": "tsx scripts/import-rosters.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.27",
    "exif-reader": "^2.0.3",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
